TEI_IMAGE=cpu-1.7
EMBEDDING_MODEL=BAAI/bge-m3
TEI_MAX_BATCH_TOKENS=16384
TEI_MAX_CLIENT_BATCH_SIZE=32
TEI_MAX_CONCURRENT=512
WEB_HOST_PORT=8080

ONTOLOGY_PATH=data/ontology_grnti.json
ONTOLOGY_SNAPSHOTS_DIR=data/snapshots

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TIMEOUT=60
MOCK_LLM=false

GIGACHAT_BASE_URL=https://your-openai-proxy.example.com/v1
GIGACHAT_TOKEN=
GIGACHAT_MODEL=GigaChat-Pro
GIGACHAT_VERIFY_SSL=true

YAGPT_BASE_URL=https://your-openai-proxy.example.com/v1
YAGPT_TOKEN=
YAGPT_MODEL=yandexgpt

AUTH_USERNAME=admin
AUTH_PASSWORD=

S3_BUCKET=
S3_KEY=ontology_grnti.json
S3_EMBEDDINGS_KEY=embeddings_cache.pkl.gz
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
